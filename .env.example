# ---- Client (exposée au navigateur, préfixe VITE_) ----
# Clé publique VAPID : `npm run vapid` génère la paire
VITE_VAPID_PUBLIC_KEY=

# ---- Serveur (fonctions /api sur Vercel) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:toi@example.com

# Upstash Redis (ou KV_REST_API_URL / KV_REST_API_TOKEN via l'intégration Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash : clés de signature (console Upstash › QStash › Signing keys)
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Facultatif : déclenchement manuel de /api/send (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
